{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".output"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["vite/client", "bun"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "paths": { "~/*": ["./src/*"] },
    "noEmit": true
  }
}
